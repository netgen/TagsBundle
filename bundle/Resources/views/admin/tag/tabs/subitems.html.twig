{% trans_default_domain 'netgen_tags_admin' %}

<div class="ng-tags-content-type-filter">
    <form method="get" action="{{ path('netgen_tags_admin_tag_show', {'tagId': tag.id}) }}">
        <label for="sort_by">{{ 'tag.subitems.sort_by'|trans }}:</label>
        <select id="sort_by" name="sort_by">
            <option value="id" {% if app.request.query.get('sort_by') == 'id' %}selected="selected"{% endif %}>
                {{ 'tag.tag_id'|trans }}
            </option>
            <option value="keyword" {% if app.request.query.get('sort_by') == 'keyword' %}selected="selected"{% endif %}>
                {{ 'tag.tag_name'|trans }}
            </option>
            <option value="modified" {% if app.request.query.get('sort_by') == 'modified' %}selected="selected"{% endif %}>
                {{ 'tag.modified'|trans }}
            </option>
            <option value="priority" {% if app.request.query.get('sort_by') == 'priority' %}selected="selected"{% endif %}>
                {{ 'tag.priority'|trans }}
            </option>
        </select>

        <label for="sort_order">{{ 'tag.subitems.sort_order'|trans }}:</label>
        <select id="sort_order" name="sort_order">
            <option value="asc" {% if app.request.query.get('sort_order') == 'asc' %}selected="selected"{% endif %}>
                {{ 'tag.subitems.sort_order.ascending'|trans }}
            </option>
            <option value="desc" {% if app.request.query.get('sort_order') == 'desc' %}selected="selected"{% endif %}>
                {{ 'tag.subitems.sort_order.descending'|trans }}
            </option>
        </select>

        <input type="submit" class="tags-btn tags-btn-primary" value="{{ 'tag.related_content.filter.button.submit'|trans }}" />
    </form>
</div>
